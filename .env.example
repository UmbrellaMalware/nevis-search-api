# Copy to .env and adjust. All values are optional for local runs.
POSTGRES_USER=nevis
POSTGRES_PASSWORD=nevis
POSTGRES_DB=nevis
API_PORT=8000
# Required header value (X-API-Key) for all endpoints except /health and docs. Empty = auth disabled.
API_KEY=
# Used by the summary worker (docker compose service `worker`); without it the worker does not start.
OPENAI_API_KEY=
